def ex_1_3_moyenne():
    
    print("=" * 60)
    
    note1 = float(input("Note 1 sur 20 : "))
    note2 = float(input("Note 2 sur 20 : "))
    note3 = float(input("Note 3 sur 20 : "))
    
    
    moyenne = (note1 + note2 + note3) / 3
    
    
    print(f"\nMoyenne : {moyenne:.2f}/20")
    
    
    if moyenne >= 16:
        print("Tres bien !")
    elif moyenne >= 14:
        print("Bien !")
    elif moyenne >= 10:
        print("Passable")
    else:
        print("Insuffisant")

if __name__ == "__main__":
    ex_1_3_moyenne()
